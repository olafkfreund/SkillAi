{
  "name": "skillai-mcp",
  "version": "0.1.0",
  "description": "Stdio MCP bridge for SkillAi — connects claude-desktop to SkillAi /api/mcp over HTTPS",
  "private": true,
  "type": "module",
  "bin": {
    "skillai-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
